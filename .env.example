# ---------------------------------------------------------------
# CafBarDLA - plantilla de configuracion
# Copie a .env y rellene. NUNCA versione el .env real.
# Genere secretos con: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------

ENVIRONMENT=development

# Obligatorios. Sin valor el arranque falla en produccion.
SECRET_KEY=
JWT_SECRET_KEY=

# Desarrollo: SQLite. Produccion: PostgreSQL obligatorio.
DATABASE_URL=sqlite:///./cafbardla.db
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/cafbardla

# Cookies: en produccion debe ser true (exige HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Origenes CORS separados por coma, CON esquema y puerto
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# --- Blindaje HTTP (Paso 16) ---
# Rate limiting: peticiones por IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
# Limite estricto del login (fuerza bruta)
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_PERIOD=300
# Proteccion CSRF de formularios
CSRF_ENABLED=true
# HSTS: activar SOLO en produccion tras configurar HTTPS/TLS
HSTS_ENABLED=false

# --- Copias de seguridad (Paso 19) ---
# Carpeta donde se guardan las copias comprimidas y verificadas.
BACKUP_DIR=backups
